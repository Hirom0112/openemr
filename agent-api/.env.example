# Copy to .env and fill in values before starting agent-api locally.
# For Railway production deployment, set these as Railway service variables.

# OpenEMR / FHIR
# NOTE: This deployment uses password grant (not client_credentials).
# OpenEMR on Railway does not support SMART backend services client_credentials flow.
OPENEMR_BASE_URL=https://your-openemr-service.up.railway.app
FHIR_CLIENT_ID=your-fhir-client-id
FHIR_CLIENT_SECRET=your-fhir-client-secret
FHIR_USERNAME=admin
FHIR_PASSWORD=your-openemr-admin-password
FHIR_USER_ROLE=users
# Leave blank to use OPENEMR_BASE_URL/oauth2/default/token
FHIR_TOKEN_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Langfuse Cloud (cloud.langfuse.com — free tier, no self-hosted instance needed)
# Get keys at: cloud.langfuse.com → project → Settings → API Keys
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Redis
# Local: redis://localhost:6380/0
# Railway: use the private internal URL from the Redis service variables
REDIS_URL=redis://localhost:6380/0

# SQLite fallback path (inside container, used when Redis is unavailable)
SQLITE_DB_PATH=/data/checkpoints.db

LOG_LEVEL=INFO
