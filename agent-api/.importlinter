[importlinter]
include_external_packages = True
root_packages =
    agent
    briefing
    triage
    query
    verification
    medication
    handoff
    auth
    checkpointer
    observability
    audit
    documents
    graph
    demographics
    rag
    observations
    parsers
    staging
    conflict

# audit is a leaf: HIPAA-style audit emission must not depend on any
# business sibling — it is consumed by the dispatcher and HTTP layer only.
[importlinter:contract:audit-is-leaf]
name = audit must not import any sibling module
type = forbidden
source_modules =
    audit
forbidden_modules =
    agent
    briefing
    triage
    query
    verification
    medication
    handoff
    auth
    checkpointer
    observability

# observability is a leaf: cross-cutting helpers (json logging, request_id,
# tool log helper) must not depend on any business sibling.
[importlinter:contract:observability-is-leaf]
name = observability must not import any sibling module
type = forbidden
source_modules =
    observability
forbidden_modules =
    agent
    briefing
    triage
    query
    verification
    medication
    handoff
    auth
    checkpointer

# auth is a leaf: it must not depend on any sibling module.
[importlinter:contract:auth-is-leaf]
name = auth must not import any sibling module
type = forbidden
source_modules =
    auth
forbidden_modules =
    agent
    briefing
    triage
    query
    verification
    medication
    handoff
    checkpointer

# checkpointer is a leaf: it must not depend on any sibling module.
[importlinter:contract:checkpointer-is-leaf]
name = checkpointer must not import any sibling module
type = forbidden
source_modules =
    checkpointer
forbidden_modules =
    agent
    briefing
    triage
    query
    verification
    medication
    handoff
    auth

# triage must not reach into query. They are siblings owned by different
# concerns; routing/search lives in query, clinical ranking in triage.
[importlinter:contract:triage-not-query]
name = triage must not import query
type = forbidden
source_modules =
    triage
forbidden_modules =
    query

# Symmetry: query must not depend on triage either.
[importlinter:contract:query-not-triage]
name = query must not import triage
type = forbidden
source_modules =
    query
forbidden_modules =
    triage

# agent.tools is the dispatcher tool surface. Sibling packages must never
# import from it (would invert the dependency direction and create cycles).
[importlinter:contract:no-upward-into-agent-tools]
name = sibling packages must not import from agent.tools
type = forbidden
source_modules =
    briefing
    triage
    query
    verification
    medication
    handoff
    auth
    checkpointer
forbidden_modules =
    agent.tools

# medication is a leaf among siblings (only depends on agent + verification,
# both of which are not in this list). It must stay decoupled from other
# clinical workflows.
[importlinter:contract:medication-isolated]
name = medication must not depend on other clinical sibling packages
type = forbidden
source_modules =
    medication
forbidden_modules =
    briefing
    triage
    query
    handoff

# Nothing other than the agent dispatcher tool surface (agent.tools) and the
# HTTP entrypoint should import handoff. Enforce that other clinical packages
# do not depend on handoff.
[importlinter:contract:handoff-not-imported-by-clinical]
name = clinical sibling packages must not import handoff
type = forbidden
source_modules =
    briefing
    triage
    query
    verification
    medication
forbidden_modules =
    handoff

# query is a top-level workflow consumed only by the dispatcher / HTTP layer.
# No other sibling clinical package should depend on it.
[importlinter:contract:query-not-imported-by-clinical]
name = clinical sibling packages must not import query
type = forbidden
source_modules =
    briefing
    triage
    verification
    medication
    handoff
forbidden_modules =
    query

# documents owns Path A/B ingestion + the copilot_doc_extractions writer.
# It depends on audit (shared asyncpg pool) but must not reach into any
# clinical sibling.  The dispatcher / HTTP layer consumes it; siblings
# do not.
# Slice 1.5 carve-out: documents.fhir_writer reuses auth.fhir_client for
# OAuth + bearer-token rather than reimplementing the password grant, so
# auth is dropped from the forbidden list (auth itself remains a leaf).
[importlinter:contract:documents-isolated]
name = documents must not depend on clinical siblings
type = forbidden
source_modules =
    documents
forbidden_modules =
    triage
    query
    briefing
    verification
    medication
    handoff
    checkpointer
    agent.tools

# graph nodes are pure-async functions invoked by the route handler.
# They must not import FastAPI / Starlette primitives — that would couple
# the LangGraph topology to the HTTP transport and break the cut-line
# fallback (W2_ARCHITECTURE risk #5: hand-rolled supervisor swap-in).
[importlinter:contract:graph-isolated]
name = graph must not depend on FastAPI, http, or external transport
type = forbidden
source_modules =
    graph
forbidden_modules =
    fastapi
    starlette

# demographics is a leaf: pure-function wrong-patient detection. It must
# not reach into any business sibling — the caller (graph.nodes.critic)
# wires it into the pipeline.
[importlinter:contract:demographics-isolated]
name = demographics must be a leaf
type = forbidden
source_modules =
    demographics
forbidden_modules =
    auth
    triage
    query
    briefing
    extractors
    documents
    audit
    agent
    graph
    checkpointer
    observability

# rag is a leaf: hybrid sparse+dense retrieval (W2 §6). It owns its own
# Postgres reads via audit's shared asyncpg pool (audit is itself a leaf)
# and must not reach into any clinical sibling. The graph retriever node
# consumes it via a local import so graph.* stays importable without
# numpy / pgvector being pulled into the collection path.
[importlinter:contract:rag-isolated]
name = rag must be a leaf
type = forbidden
source_modules =
    rag
forbidden_modules =
    auth
    triage
    query
    briefing
    extractors
    documents
    demographics
    agent
    graph
    checkpointer
    verification
    handoff
    medication

# observations is a Phase-2 leaf among siblings: writes one FHIR
# Observation per extracted LabValue via the custom Co-Pilot endpoint.
# It needs documents.fhir_writer (for the shared _mint_copilot_jwt
# helper) and extractors.schemas (the LabValue type), so those are
# carved out — but no clinical sibling (triage/query/briefing/etc.)
# may be touched. The dispatcher / HTTP layer (main.py) consumes it.
[importlinter:contract:observations-isolated]
name = observations must not depend on clinical siblings
type = forbidden
source_modules =
    observations
forbidden_modules =
    triage
    query
    briefing
    verification
    medication
    handoff
    checkpointer
    agent.tools
    graph
    rag
    demographics

# Phase 9 Slice 9.1 — multimodal-ingestion package boundaries.
#
# parsers.hl7 is a structured-lane leaf: deterministic HL7 v2 message parsing
# producing existing LabReport / IntakeForm instances. It must not reach into
# clinical siblings or the dispatcher tool surface, and must not pull HTTP
# transport libraries — parsers run in-process behind the ingest route.
[importlinter:contract:parsers-hl7-isolated]
name = parsers.hl7 must be a structured-lane leaf
type = forbidden
source_modules =
    parsers.hl7
forbidden_modules =
    triage
    query
    briefing
    verification
    medication
    handoff
    checkpointer
    agent
    agent.tools
    graph
    rag
    demographics
    fastapi
    starlette
    httpx

# parsers.xlsx is a structured-lane leaf: openpyxl-driven 4-sheet importer
# emitting IntakeForm + LabReport + PendingTask. Same isolation as parsers.hl7
# minus the HTTP-transport ban (xlsx parsing is purely in-memory).
[importlinter:contract:parsers-xlsx-isolated]
name = parsers.xlsx must be a structured-lane leaf
type = forbidden
source_modules =
    parsers.xlsx
forbidden_modules =
    triage
    query
    briefing
    verification
    medication
    handoff
    checkpointer
    agent
    agent.tools
    graph
    rag
    demographics

# staging is the pending-write subsystem (copilot_pending_extractions). It
# consumes audit (shared asyncpg pool), observations (writer entry points
# for the post-approval landing), documents (DocumentReference linkage),
# extractors (typed payloads), auth (JWT mint helpers), and observability
# (logging + metrics). It must not import any clinical sibling, the
# dispatcher tool surface, the LangGraph topology, or the RAG retriever.
[importlinter:contract:staging-isolated]
name = staging must not depend on clinical siblings
type = forbidden
source_modules =
    staging
forbidden_modules =
    triage
    query
    briefing
    verification
    medication
    handoff
    checkpointer
    agent
    agent.tools
    graph
    rag
    demographics

# conflict is a near-leaf cross-source disagreement detector consumed by a
# single graph node (graph.nodes.cross_source_conflict). It owns its own
# ranking + dedup; it must not reach into the dispatcher, clinical siblings,
# the auth/checkpointer/handoff plumbing, or the documents/RAG/graph layers.
# It is allowed to import extractors.schemas (typed payloads) and
# observability (logging + metrics) — not listed here because forbidden lists
# are explicit allowlists-by-omission.
[importlinter:contract:conflict-is-mostly-leaf]
name = conflict must be a near-leaf
type = forbidden
source_modules =
    conflict
forbidden_modules =
    agent
    briefing
    triage
    query
    verification
    medication
    handoff
    auth
    checkpointer
    documents
    graph
    demographics
    rag
