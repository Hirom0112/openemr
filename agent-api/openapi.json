    "/agent/prefetch": {
      "post": {
        "summary": "Agent Prefetch",
        "description": "Signal that the React panel has mounted and FHIR pre-fetch should begin.\n\nV1: acknowledges immediately; the actual cache warming is handled by the\nexisting FHIR client on the first get_census_summary tool call.  This\nendpoint exists so the UI can fire a non-blocking fetch on mount without\nwaiting for it \u2014 keeping the session-open flow in UX_SPEC \u00a73 intact.",
        "operationId": "agent_prefetch_agent_prefetch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrefetchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Agent Prefetch Agent Prefetch Post"
                }
              }
            }
          },
          "422": {
