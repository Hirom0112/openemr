  "components": {
    "schemas": {
      "AgentQueryRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "provider_id": {
            "type": "string",
            "title": "Provider Id"
          },
          "patient_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Patient Ids",
            "default": []
          },
          "provider_name": {
            "type": "string",
            "title": "Provider Name",
            "default": "Provider"
          },
          "census_context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Census Context"
          }
        },
        "type": "object",
        "required": [
          "message",
          "session_id",
          "provider_id"
        ],
        "title": "AgentQueryRequest"
      },
      "BriefingResponse": {
        "properties": {
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/BriefingSection"
            },
            "type": "array",
            "title": "Sections"
          },
          "alerts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Alerts",
            "description": "Hard alerts that must always be shown: critical labs, blank code status, stale values."
          },
          "generated_at": {
            "type": "string",
            "title": "Generated At",
            "description": "ISO-8601 UTC timestamp of generation."
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "name",
          "generated_at"
        ],
        "title": "BriefingResponse"
      },
      "BriefingSection": {
        "properties": {
          "section": {
            "type": "string",
            "title": "Section",
            "description": "Section name: diagnosis | medications | vitals | labs | allergies | alerts"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "1-2 sentence plain-English summary of the section."
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ClinicalClaim"
            },
            "type": "array",
            "title": "Claims",
            "description": "Individual clinical claims with source attribution."
          }
        },
        "type": "object",
        "required": [
          "section",
          "summary",
          "claims"
        ],
        "title": "BriefingSection"
      },
      "CensusRequest": {
        "properties": {
          "patient_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Patient Ids"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "patient_ids"
        ],
        "title": "CensusRequest"
      },
      "ClientTimingRequest": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "t_navigation_start_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "T Navigation Start Ms"
          },
          "extra": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra"
          }
        },
        "type": "object",
        "required": [
          "action",
          "duration_ms"
        ],
        "title": "ClientTimingRequest"
      },
      "ClinicalClaim": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "The clinical statement in plain English."
          },
          "source_resource": {
            "type": "string",
            "title": "Source Resource",
            "description": "FHIR resource type (Observation, Condition, etc.)"
          },
          "source_code": {
            "type": "string",
            "title": "Source Code",
            "description": "LOINC or SNOMED code of the source record."
          },
          "source_value": {
            "type": "string",
            "title": "Source Value",
            "description": "Exact value from the source record."
          },
          "source_dt": {
            "type": "string",
            "title": "Source Dt",
            "description": "ISO-8601 effective date/time of the source record."
          }
        },
        "type": "object",
        "required": [
          "text",
          "source_resource",
          "source_code",
          "source_value",
          "source_dt"
        ],
        "title": "ClinicalClaim"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandoffRequest": {
        "properties": {
          "patient_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Patient Ids"
          }
        },
        "type": "object",
        "required": [
          "patient_ids"
        ],
        "title": "HandoffRequest"
      },
      "MessageRequest": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "default": "user"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "MessageRequest"
      },
      "PrefetchRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "provider_id": {
            "type": "string",
            "title": "Provider Id"
          },
          "patient_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Patient Ids",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "provider_id"
        ],
        "title": "PrefetchRequest"
      },
      "QueryRequest": {
        "properties": {
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "query": {
            "type": "string",
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "query"
        ],
        "title": "QueryRequest"
      },
      "TriageRationaleRequest": {
        "properties": {
          "patient_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "provider_id": {
            "type": "string",
            "title": "Provider Id",
            "default": "system"
          }
        },
        "type": "object",
        "title": "TriageRationaleRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
