    "/diag/fhir": {
      "get": {
        "summary": "Diag Fhir",
        "description": "One-shot FHIR connectivity probe. Gated by COPILOT_DIAG env flag.\n\nForces a fresh token, performs GET /Patient?identifier=1, and returns\nthe resolved URL, status, body snippet, and token metadata. Never logs\nor returns the bearer token itself.",
