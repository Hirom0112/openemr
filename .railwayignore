__pycache__/
**/__pycache__/
*.pyc
.venv/
**/.venv/
agent-ui/dist/
agent-ui/node_modules/
.idea/
.vscode/
.DS_Store
**/.DS_Store
.phpunit.result.cache
.php-cs-fixer.cache
