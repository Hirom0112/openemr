# Whitelist only the directories the Dockerfile actually COPYs onto the
# openemr/openemr:latest base image. Everything else (vendor/, public/,
# tests/, sql/, .git/, node_modules/) is either provided by the base image
# or irrelevant at runtime.
*
!Dockerfile
!docker-entrypoint-wrapper.sh
!src/
!src/**
!interface/
!interface/**
