# Whitelist only the directories the Dockerfile actually COPYs onto the
# openemr/openemr:latest base image. Everything else (vendor/, public/,
# tests/, sql/, .git/, node_modules/) is either provided by the base image
# or irrelevant at runtime.
*
!Dockerfile
!docker-entrypoint-wrapper.sh
!src/
!src/**
!library/
!library/**
!interface/
!interface/**
!templates/
!templates/**
!controllers/
!controllers/**
!scripts/
!scripts/**
# composer.json + lock are needed by the autoload-regen step in the
# Dockerfile (see comment on the COPY composer.* line). Without these
# whitelist entries, the * blocklist excludes them from the build
# context and the COPY fails with "composer.lock: not found".
!composer.json
!composer.lock
