{
  "name": "ui-bug-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Claude agent that explores the OpenEMR UI via Playwright MCP and reports bugs.",
  "scripts": {
    "hunt": "tsx src/hunt.ts",
    "install-browsers": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@playwright/mcp": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
