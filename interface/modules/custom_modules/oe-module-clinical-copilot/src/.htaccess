# Defense-in-depth deny-all on the module's PHP source directory.
# These files are PSR-4 classes (JwtMinter, UploadController) — they should
# only be loaded via require_once / autoload from authenticated entry points
# (interface/main/tabs/main.php, public/upload.php). Direct HTTP access is
# never legitimate, so refuse it before PHP even parses the file.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
